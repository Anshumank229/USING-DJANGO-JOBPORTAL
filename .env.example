# Copy this file to .env and fill in real values. Never commit the actual .env file.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — leave unset to use local SQLite.
# For Postgres (e.g. on Render/Railway), it looks like:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# CORS — comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (leave blank to keep using the console backend in dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
